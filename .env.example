# ============================================================
# Karimnagar Business Hunter AI - Environment Configuration Example
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env to version control!
# ============================================================

# Server Settings
PORT=4800
NODE_ENV=development

# 1. AI Providers (Gemini + OpenRouter)
# Required for autonomous lead analysis, design architecture, and outreach copywriting
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# 2. Public Lead Discovery APIs (Optional fallbacks)
# OpenStreetMap Overpass & Nominatim require NO API keys.
# Google Places and Tavily can augment discovery if configured:
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# 3. Telegram Bot Reporting
# Required for sending daily reports and instant lead alerts to your Telegram chat.
# Obtain from @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Your numeric Telegram Chat ID or group ID (obtain from @userinfobot)
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# 4. GitHub Pages Deployment
# GitHub account and repository name for hosting generated website demos
GITHUB_OWNER=naveenk7100-ship-it
GITHUB_DEMO_REPO=karimnagar-business-demos
GITHUB_TOKEN=your_personal_access_token_if_not_using_gh_cli
